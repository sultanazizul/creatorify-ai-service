{
    "info": {
        "name": "InfiniTalk API - Benchmark & Test Suite v2.1",
        "description": "Complete testing suite for InfiniTalk Video Avatar Generator. Includes dedicated Benchmarking section for analyzing Quality vs Speed across different presets.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
        "_postman_id": "infinitetalk-api-v2.1",
        "version": "2.1.0"
    },
    "auth": {
        "type": "apikey",
        "apikey": [
            {
                "key": "value",
                "value": "{{API_KEY}}",
                "type": "string"
            },
            {
                "key": "key",
                "value": "X-API-Key",
                "type": "string"
            }
        ]
    },
    "variable": [
        {
            "key": "BASE_URL",
            "value": "https://your-modal-app.modal.run",
            "type": "string"
        },
        {
            "key": "API_KEY",
            "value": "your-api-key-here",
            "type": "string"
        },
        {
            "key": "PROJECT_ID",
            "value": "",
            "type": "string"
        },
        {
            "key": "TEST_IMAGE_URL",
            "value": "https://example.com/test-avatar.jpg",
            "type": "string"
        },
        {
            "key": "TEST_AUDIO_URL",
            "value": "https://example.com/test-audio-10s.wav",
            "type": "string"
        },
        {
            "key": "TEST_AUDIO_URL_2",
            "value": "https://example.com/test-audio2-10s.wav",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "0. Benchmark Suite (Start Here)",
            "item": [
                {
                    "name": "0.1 Benchmark: Turbo Mode (4 steps)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"user_id\": \"benchmark_user\",\n  \"title\": \"BENCHMARK: Turbo (4 steps)\",\n  \"description\": \"Testing extreme speed with Turbo preset\",\n  \"image_url\": \"{{TEST_IMAGE_URL}}\",\n  \"audio_url\": \"{{TEST_AUDIO_URL}}\",\n  \"parameters\": {\n    \"quality_preset\": \"turbo\",\n    \"resolution\": \"480p\"\n  }\n}"
                        },
                        "url": {
                            "raw": "{{BASE_URL}}/api/v1/projects/",
                            "host": [
                                "{{BASE_URL}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "projects",
                                ""
                            ]
                        },
                        "description": "Test the new 'turbo' preset (4 steps, LoRA). Monitor generation time."
                    }
                },
                {
                    "name": "0.2 Benchmark: Fast Mode (8 steps)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"user_id\": \"benchmark_user\",\n  \"title\": \"BENCHMARK: Fast (8 steps)\",\n  \"description\": \"Baseline comparison for speed/quality\",\n  \"image_url\": \"{{TEST_IMAGE_URL}}\",\n  \"audio_url\": \"{{TEST_AUDIO_URL}}\",\n  \"parameters\": {\n    \"quality_preset\": \"fast\",\n    \"resolution\": \"480p\"\n  }\n}"
                        },
                        "url": {
                            "raw": "{{BASE_URL}}/api/v1/projects/",
                            "host": [
                                "{{BASE_URL}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "projects",
                                ""
                            ]
                        },
                        "description": "Test standard 'fast' preset."
                    }
                },
                {
                    "name": "0.3 Benchmark: Low VRAM (FP8)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"user_id\": \"benchmark_user\",\n  \"title\": \"BENCHMARK: Low VRAM (FP8)\",\n  \"description\": \"Testing FP8 quantization efficiency\",\n  \"image_url\": \"{{TEST_IMAGE_URL}}\",\n  \"audio_url\": \"{{TEST_AUDIO_URL}}\",\n  \"parameters\": {\n    \"quality_preset\": \"low_vram\",\n    \"resolution\": \"480p\"\n  }\n}"
                        },
                        "url": {
                            "raw": "{{BASE_URL}}/api/v1/projects/",
                            "host": [
                                "{{BASE_URL}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "projects",
                                ""
                            ]
                        },
                        "description": "Test 'low_vram' preset. Checks if it runs on lower memory tiers."
                    }
                },
                {
                    "name": "0.4 Benchmark: Quality 720p (High Res)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"user_id\": \"benchmark_user\",\n  \"title\": \"BENCHMARK: Quality 720p\",\n  \"description\": \"Testing max quality capability\",\n  \"image_url\": \"{{TEST_IMAGE_URL}}\",\n  \"audio_url\": \"{{TEST_AUDIO_URL}}\",\n  \"parameters\": {\n    \"quality_preset\": \"quality\",\n    \"resolution\": \"720p\"\n  }\n}"
                        },
                        "url": {
                            "raw": "{{BASE_URL}}/api/v1/projects/",
                            "host": [
                                "{{BASE_URL}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "projects",
                                ""
                            ]
                        },
                        "description": "Test maximum quality. warning: Requires >24GB VRAM (A100)."
                    }
                }
            ],
            "description": "Dedicated suite for analyzing performance across different parameter configurations."
        },
